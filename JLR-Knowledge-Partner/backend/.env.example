# JLR Knowledge Partner - backend settings.
# Copy to .env (the installer does this and asks for the key). Never share or commit the .env file.

# ============ Azure OpenAI ============
# Leave ENDPOINT or CHAT_DEPLOYMENT empty to run in offline mode (extractive answers, local models).
AZURE_OPENAI_ENDPOINT=https://dinesh12active-2688-resource.cognitiveservices.azure.com/
# key   = use AZURE_OPENAI_API_KEY
# entra = keyless: DefaultAzureCredential (az login locally, managed identity in Azure,
#         or AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET for a service principal).
AZURE_OPENAI_AUTH=key
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# DEPLOYMENT names (Azure AI Foundry > Deployments), not model names
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# gpt-5 / o-series are reasoning models (no temperature, use reasoning effort)
LLM_REASONING_MODEL=true
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Optional faster deployment for planning / judging / rewrites (e.g. gpt-4.1-mini); empty = chat deployment.
AZURE_OPENAI_FAST_DEPLOYMENT=
# LLM_FAST_REASONING_MODEL=false   # set when the fast deployment is a non-reasoning model

# Embeddings. The stored knowledge base was built with text-embedding-3-small (1536 dims) in the
# "kg_azure" collections: keep these two lines together, or change COLLECTION_PREFIX and re-ingest.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=0
COLLECTION_PREFIX=kg_azure

# ============ Pictures in documents (vision) ============
# Empty = pictures are extracted and wait. Use the COMPANY Azure resource here.
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_VISION_ENDPOINT=
AZURE_OPENAI_VISION_API_KEY=
# VISION_REASONING_MODEL=false
# VISION_PRICE_INPUT_PER_1M=0
# VISION_PRICE_OUTPUT_PER_1M=0

# ============ Local models from a folder (no download) ============
# BM25 and the reranker are always local. If this PC cannot download them, point to the model folders.
# SPARSE_EMBEDDING_PATH=C:/Users/<user>/.cache/huggingface/hub/models--qdrant--bm25/snapshots/<hash>
# RERANKER_PATH=C:/Users/<user>/Downloads/ms-marco-MiniLM-L6-v2/ms-marco-MiniLM-L6-v2   (ONNX: needs onnx/model.onnx)

# ============ Qdrant ============
# Empty URL = embedded on-disk mode in ./data/qdrant (single process only)
QDRANT_URL=
QDRANT_API_KEY=

# ============ RAG ============
RERANK_ENABLED=true
TOP_K=8
MIN_RELEVANCE=0.3

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ Accounts ============
# Any SQLAlchemy URL; default is SQLite at backend/data/app.db.
DATABASE_URL=
# Empty = a random secret is generated once into backend/data/.jwt_secret (keep that file private).
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

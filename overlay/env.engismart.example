
# ============================================================================
# Engismart (knowledge assistant) - add these to .env.<ENVIRONMENT>. Every key is optional; empty Azure keys = offline mode.
# The database is the platform's own (DATABASE_*). Engismart owns one table, tbl_engismart_image (docs/ENGISMART_TABLES.sql).
# ============================================================================
# --- Azure OpenAI (chat + embeddings + pictures)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_AUTH=key                      # key | entra
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_VISION_DEPLOYMENT=            # a multimodal deployment (GPT-4o); empty = pictures are extracted but not described
LLM_REASONING_MODEL=false                  # true for o-series / gpt-5 deployments
# --- search index (Qdrant): empty URL = embedded folder (one process only); a server is needed with several workers
QDRANT_URL=
QDRANT_API_KEY=
# --- local models folders (offline machines)
DOCLING_ARTIFACTS_PATH=
RERANKER_PATH=
SPARSE_EMBEDDING_PATH=
PDF_ENGINE=auto                            # auto | docling | pypdf
# --- who is who: platform application roles (tbl_application_roles.permission_alias) -> Engismart roles; no role = plain user.
# Domains are NOT set here: DevOps gives people the platform application rows engismart_<domain> (docs/REGISTER_APPLICATION.sql).
ROLE_DEVELOPER=engismart_developer
ROLE_SUPERUSER=engismart_superuser
ADMIN_IS_DEVELOPER=true
ACCESS_CACHE_S=30                          # seconds a person's roles and domains are remembered (0 = look them up on every call)
WARM_UP_ON_START=true                      # open the search index in the background when the app starts
# --- uploads: every file is scanned by ClamAV (FILE_SCANNING_IP / FILE_SCANNING_PORT of the platform) before it is accepted
MAX_UPLOAD_MB=100
VIRUS_SCAN=on                              # on | off (off only on a developer machine without ClamAV)
# --- cost column of tbl_langfuse_usage_logs: price per 1M tokens of the chat deployment (0 = cost stays 0, tokens are still counted)
LLM_PRICE_INPUT_PER_1M=0
LLM_PRICE_OUTPUT_PER_1M=0
# --- files: everything we write goes to STORAGE_ROOT/engismart (set STORAGE_ROOT to a shared volume)
